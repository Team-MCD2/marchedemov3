<!-- Promotions Autoplay and Translation Animation script -->
<script is:inline>
  document.addEventListener("astro:page-load", () => {
    const track = document.getElementById("promo-carousel-track");
    const dot0 = document.getElementById("promo-dot-0");
    const dot1 = document.getElementById("promo-dot-1");
    if (!track || !dot0 || !dot1) return;

    let currentSlide = 0;
    let autoplayTimer = null;

    const showSlide = (index) => {
      currentSlide = index;
      track.style.transform = `translateX(-${index * 100}%)`;
      if (index === 0) {
        dot0.classList.remove("bg-neutral-350", "hover:bg-neutral-450");
        dot0.classList.add("bg-rouge");
        dot1.classList.remove("bg-rouge");
        dot1.classList.add("bg-neutral-350", "hover:bg-neutral-450");
      } else {
        dot1.classList.remove("bg-neutral-350", "hover:bg-neutral-450");
        dot1.classList.add("bg-rouge");
        dot0.classList.remove("bg-rouge");
        dot0.classList.add("bg-neutral-350", "hover:bg-neutral-450");
      }
    };

    dot0.addEventListener("click", () => {
      showSlide(0);
      resetAutoplay();
    });

    dot1.addEventListener("click", () => {
      showSlide(1);
      resetAutoplay();
    });

    const startAutoplay = () => {
      autoplayTimer = setInterval(() => {
        const nextSlide = (currentSlide + 1) % 2;
        showSlide(nextSlide);
      }, 5500);
    };

    const resetAutoplay = () => {
      if (autoplayTimer) clearInterval(autoplayTimer);
      startAutoplay();
    };

    startAutoplay();
  });
</script>
