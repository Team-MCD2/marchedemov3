---
export const prerender = false;

import Layout from "@layouts/Layout.astro";
import RayonCard from "@components/RayonCard.astro";
import PromoCard from "@components/PromoCardV3.astro";
import ProduitCard from "@components/ProduitCardV3.astro";
import RecetteCard from "@components/RecetteCard.astro";
import Stats from "@components/Stats.astro";
import FAQAccordion from "@components/FAQAccordion.astro";
import NewsletterInline from "@components/NewsletterInline.astro";
import LocalVideoPlayer from "@components/LocalVideoPlayer.astro";
import PromoHero, { type ExtraSlide } from "@components/PromoHeroV3.astro";
import ActuCarousel from "@components/ActuCarousel.astro";
import { getActus } from "@/lib/actus";
import { getCollection } from "astro:content";
import { RAYONS_LIST, ENGAGEMENTS, MAGASINS, SITE } from "@/lib/site";
import { getRecettesVedettes } from "@/lib/recettes";
import { FAQ_HOME } from "@/lib/faqs";
import { organizationSchema, websiteSchema, allMagasinsSchema, offerSchema } from "@/lib/schema";
import { getActivePromos } from "@/lib/promos-repo";
import { getProduitsVedettes, getProduitsByRayon } from "@/lib/produits-repo";
import { getHomeEditorialSlides, getHomeSeoSettings } from "@/lib/home-content";

// Accent colors matching V2 rayons for dots/tags
const CATEGORY_ACCENTS: Record<string, string> = {
  "boucherie-halal": "#8B1919",
  "fruits-legumes": "#2E8B4A",
  "epices-du-monde": "#A86B1E",
  "saveurs-afrique": "#C8751A",
  "saveurs-asie": "#1E5F74",
  "saveur-mediterranee": "#0F52BA",
  "saveur-sud-amer": "#B22222",
  "balkans-turques": "#D2691E",
  "produits-courants": "#4A5568",
  "surgeles": "#00A86B",
};


// 1. Fetch promotional, editorial, and SEO configurations
const allPromos = await getActivePromos();
const featuredPromo =
  allPromos.find((p) => p.data.ticker_semaine) ??
  allPromos.find((p) => p.data.mise_en_avant) ??
  allPromos[0];
const promosHome = allPromos.slice(0, 6);
const promosHero = allPromos.filter((p) => p.data.mise_en_avant).slice(0, 4);

const heroEditorialSlides: ExtraSlide[] = await getHomeEditorialSlides();
const seoSettings = await getHomeSeoSettings();
const actus = await getActus(12);
const videos = (await getCollection("videos", (v) => v.data.actif && v.data.rayon === "home"))
  .sort((a, b) => a.data.ordre - b.data.ordre);

// 2. Fetch products for the 5 cultural sections
const maghrebProducts = (await getProduitsByRayon("saveur-mediterranee")).slice(0, 4);
const asieProducts = (await getProduitsByRayon("saveurs-asie")).slice(0, 4);
const creoleProducts = (await getProduitsByRayon("saveurs-afrique")).slice(0, 4);
const indeProducts = (await getProduitsByRayon("epices-du-monde")).slice(0, 4);

// Italie doesn't have its own rayon, so we filter Mediterranean products for Italian origins, fallback to others
const allMediterranee = await getProduitsByRayon("saveur-mediterranee");
const italieProducts = allMediterranee.filter(p => p.origine === "Italie" || p.nom.toLowerCase().includes("italie") || p.nom.toLowerCase().includes("pesto") || p.nom.toLowerCase().includes("pasta")).slice(0, 4);
if (italieProducts.length < 4) {
  const maghrebSlugs = new Set(maghrebProducts.map(p => p.slug));
  const remainingMed = allMediterranee.filter(p => !maghrebSlugs.has(p.slug));
  for (const p of remainingMed) {
    if (italieProducts.length >= 4) break;
    if (!italieProducts.find(ip => ip.slug === p.slug)) {
      italieProducts.push(p);
    }
  }
}

// 3. Schema.org metadata configuration
const schemas = [
  organizationSchema(),
  websiteSchema(),
  ...allMagasinsSchema(),
  ...(featuredPromo ? [offerSchema(featuredPromo.data)] : []),
];
---

<Layout
  title={seoSettings.title}
  description={seoSettings.description}
  ogImage={seoSettings.ogImage}
  faqItems={FAQ_HOME}
  schema={schemas}
  heroImage="/promos/promo_rectangulaire.webp"
>
  {/* ====================== 1 · HERO BANNER SLIDER (PromoHeroV3) ====================== */}
  <PromoHero
    promos={promosHero}
    extraSlides={heroEditorialSlides}
    autoAdvanceMs={3200}
  />

  {/* ====================== 2 · PROMOTIONS DE LA SEMAINE CAROUSEL (3x3 Motion) ====================== */}
  {promosHome.length > 0 && (
    <section class="section bg-neutral-50/50 border-b border-neutral-100 py-10 relative overflow-hidden">
      <div class="container-mo">
        <div class="relative overflow-hidden w-full select-none">
          <!-- Slide track -->
          <div id="promo-carousel-track" class="flex transition-transform duration-700 ease-in-out w-full" style="transform: translateX(0%);">
            <!-- Slide 1: First 3 promotions -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 w-full shrink-0 px-1">
              {promosHome.slice(0, 3).map((p) => (
                <PromoCard
                  slug={p.slug}
                  titre={p.data.titre}
                  description={p.data.description}
                  image={p.data.image}
                  prix_original={p.data.prix_original}
                  prix_promo={p.data.prix_promo}
                  reduction_pct={p.data.reduction_pct}
                  rayon={p.data.rayon}
                  magasin={p.data.magasin}
                  date_fin={p.data.date_fin}
                  featured={p.data.mise_en_avant}
                />
              ))}
            </div>
            
            <!-- Slide 2: Remaining 3 promotions -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 w-full shrink-0 px-1">
              {promosHome.slice(3, 6).map((p) => (
                <PromoCard
                  slug={p.slug}
                  titre={p.data.titre}
                  description={p.data.description}
                  image={p.data.image}
                  prix_original={p.data.prix_original}
                  prix_promo={p.data.prix_promo}
                  reduction_pct={p.data.reduction_pct}
                  rayon={p.data.rayon}
                  magasin={p.data.magasin}
                  date_fin={p.data.date_fin}
                  featured={p.data.mise_en_avant}
                />
              ))}
            </div>
          </div>

          <!-- Dot controllers -->
          {promosHome.length > 3 && (
            <div class="flex items-center justify-center gap-2.5 mt-6">
              <button 
                id="promo-dot-0" 
                class="w-3.5 h-3.5 rounded-full bg-rouge transition-all duration-300 focus:outline-none" 
                aria-label="Groupe 1 des promotions"
              ></button>
              <button 
                id="promo-dot-1" 
                class="w-3.5 h-3.5 rounded-full bg-neutral-350 hover:bg-neutral-450 transition-all duration-300 focus:outline-none" 
                aria-label="Groupe 2 des promotions"
              ></button>
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  {/* ====================== 3 · URGENCY PROMO TICKER ====================== */}
  {featuredPromo && (
    <section class="relative overflow-hidden bg-rouge text-white animate-fade-up">
      <div class="container-mo py-4 md:py-5 flex flex-wrap items-center gap-x-6 gap-y-2 text-[13px] md:text-[14px] font-pro">
        <span class="inline-flex items-center gap-2 font-bold">
          <span class="badge-promo !bg-white !text-rouge !shadow-none !min-w-0 !h-auto !px-2 !py-0.5 !text-[12px]">
            -{featuredPromo.data.reduction_pct}%
          </span>
          Offre de la semaine
        </span>
        <span>
          <strong>{featuredPromo.data.titre}</strong> ·
          {featuredPromo.data.prix_promo} € au lieu de {featuredPromo.data.prix_original} €
        </span>
        <a href="/promos" class="ml-auto font-bold underline underline-offset-4 hover:opacity-80 transition">
          Voir toutes les promos →
        </a>
      </div>
    </section>
  )}

  {/* ====================== 4 · LES IMMANQUABLES GRID (Leclerc Replica Section 2) ====================== */}
  <section class="section bg-neutral-50 pb-8 border-b border-neutral-100">
    <div class="container-mo">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5 mb-5">
        <!-- Banner 1: Boucherie Halal -->
        <a href="/rayons/boucherie-halal" class="group relative block aspect-[16/9] md:aspect-auto md:h-[240px] rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-all">
          <img src="/images/rayons/boucherie-halal.jpg" alt="Boucherie Halal" class="absolute inset-0 w-full h-full object-cover group-hover:scale-102 transition-transform duration-500" />
          <div class="absolute inset-0 bg-gradient-to-r from-black/85 via-black/40 to-transparent flex flex-col justify-end p-5 text-white">
            <span class="text-[10px] font-black uppercase bg-vert px-2 py-0.5 rounded w-fit mb-1.5">Direct Boucher</span>
            <h3 class="font-soft font-bold text-[18px] leading-tight">BOUCHERIE HALAL</h3>
            <p class="text-[12px] text-white/80 leading-snug mt-1">Sélection sur carcasse d'agneau et de bœuf.</p>
            <span class="mt-3 text-[12px] font-bold text-vert-light group-hover:text-white transition-colors flex items-center gap-1">Voir la sélection <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M13 5l7 7-7 7" /></svg></span>
          </div>
        </a>

        <!-- Banner 2: Fruits & Légumes -->
        <a href="/rayons/fruits-legumes" class="group relative block aspect-[16/9] md:aspect-auto md:h-[240px] rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-all">
          <img src="/images/rayons/fruits-legumes.jpg" alt="Fruits & Légumes" class="absolute inset-0 w-full h-full object-cover group-hover:scale-102 transition-transform duration-500" />
          <div class="absolute inset-0 bg-gradient-to-r from-black/85 via-black/40 to-transparent flex flex-col justify-end p-5 text-white">
            <span class="text-[10px] font-black uppercase bg-vert px-2 py-0.5 rounded w-fit mb-1.5">Frais et Saisons</span>
            <h3 class="font-soft font-bold text-[18px] leading-tight">FRUITS &amp; LÉGUMES</h3>
            <p class="text-[12px] text-white/80 leading-snug mt-1">Arrivages réguliers et produits exotiques.</p>
            <span class="mt-3 text-[12px] font-bold text-vert-light group-hover:text-white transition-colors flex items-center gap-1">En profiter <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M13 5l7 7-7 7" /></svg></span>
          </div>
        </a>

        <!-- Banner 3: Épicerie du Monde -->
        <a href="/promos" class="group relative block aspect-[16/9] md:aspect-auto md:h-[240px] rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-all">
          <img src="/images/rayons/epices-du-monde.jpg" alt="Épices & Épicerie du Monde" class="absolute inset-0 w-full h-full object-cover group-hover:scale-102 transition-transform duration-500" />
          <div class="absolute inset-0 bg-gradient-to-r from-black/85 via-black/40 to-transparent flex flex-col justify-end p-5 text-white">
            <span class="text-[10px] font-black uppercase bg-vert px-2 py-0.5 rounded w-fit mb-1.5">Bons Plans</span>
            <h3 class="font-soft font-bold text-[18px] leading-tight">ÉPICERIE DU MONDE</h3>
            <p class="text-[12px] text-white/80 leading-snug mt-1">Sélection d'épices, d'huiles et de douceurs orientales.</p>
            <span class="mt-3 text-[12px] font-bold text-vert-light group-hover:text-white transition-colors flex items-center gap-1">Voir les offres <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M13 5l7 7-7 7" /></svg></span>
          </div>
        </a>
      </div>

      <!-- Long horizontal Trampoline Woodsun equivalent promo banner -->
      <a href="/promos" class="group relative block w-full rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-all bg-vert/5 border border-vert/10">
        <div class="flex flex-col md:flex-row items-center justify-between p-6 md:p-8 gap-6">
          <div class="flex items-center gap-5">
            <!-- Promo Icon Badge -->
            <div class="w-16 h-16 rounded-full bg-rouge text-white flex flex-col items-center justify-center font-black select-none flex-shrink-0 border-2 border-white shadow">
              <span class="text-[16px] leading-none">-40%</span>
            </div>
            <div class="text-left">
              <span class="text-[11px] font-black text-rouge uppercase tracking-wider block mb-1">Immanquable de la semaine</span>
              <h3 class="font-soft font-bold text-[20px] md:text-[24px] text-neutral-900 leading-tight">Agneau entier cost-price Aïd el Kebir</h3>
              <p class="text-[13.5px] text-neutral-600 mt-1 max-w-xl">Disponible en commande exclusive pour vos fêtes de famille, découpé par nos artisans.</p>
            </div>
          </div>
          
          <div class="flex items-center gap-4 flex-shrink-0">
            <div class="text-right select-none leading-none pr-4 border-r border-neutral-200">
              <span class="text-[32px] font-black text-rouge align-middle">290</span>
              <sup class="text-[15px] font-bold text-rouge align-super ml-0.5">€,00</sup>
              <span class="text-[10px] text-neutral-400 block mt-1.5">L'unité complète</span>
            </div>
            <span class="btn btn-rouge font-bold text-[13.5px] px-6 py-2.5 rounded-full group-hover:bg-rouge-dark transition-all">
              Commander
            </span>
          </div>
        </div>
      </a>
    </div>
  </section>

  {/* ====================== 5 · ACHETER PAR RAYON (Leclerc Replica Section 4) ====================== */}
  <section class="section bg-white border-b border-neutral-100 py-12">
    <div class="container-mo">
      <div class="mb-8 select-none text-left">
        <h2 class="font-soft font-black text-[22px] md:text-[26px] text-neutral-900 tracking-tight">
          Acheter par rayon
        </h2>
      </div>

      <!-- Circular visual buttons for Mo's 10 departments -->
      <div class="grid grid-cols-2 sm:grid-cols-5 lg:grid-cols-10 gap-4 md:gap-5 justify-items-center">
        {RAYONS_LIST.map((r) => {
          const rayonImg = `/images/rayons/${r.slug}.jpg`;
          return (
            <a href={`/rayons/${r.slug}`} class="group flex flex-col items-center text-center w-full max-w-[100px]">
              <!-- Circular masked image frame -->
              <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-full overflow-hidden bg-neutral-50 shadow-sm border border-neutral-200/50 group-hover:border-vert/30 group-hover:shadow-md transition-all duration-300 relative flex items-center justify-center mb-2">
                <img 
                  src={rayonImg} 
                  alt="" 
                  class="w-[102%] h-[102%] object-cover group-hover:scale-105 transition-transform duration-500"
                />
              </div>
              <span class="text-[11.5px] font-bold text-neutral-700 leading-snug group-hover:text-vert transition-colors break-words">
                {r.nomCourt}
              </span>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  {/* Intermediate Logo signature area 1 (Break after rayons) */}
  <div
    class="w-full flex flex-col items-center overflow-hidden border-t border-b border-neutral-100 py-8 select-none"
    style="background: radial-gradient(circle at center, rgba(46, 139, 74, 0.05) 0%, rgba(255, 255, 255, 0) 80%), url('data:image/svg+xml,%3Csvg width=\'120\' height=\'24\' viewBox=\'0 0 120 24\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Cpath d=\'M0 12 Q 30 0, 60 12 T 120 12\' fill=\'none\' stroke=\'%231c6b35\' stroke-width=\'1.5\' stroke-opacity=\'0.04\'/%3E%3C/svg%3E') repeat;"
  >
    <div class="group relative block shrink-0">
      <img
        src="/logos/logo-marchedemo-rond-contourgreen.png"
        alt="Marché de Mo'"
        width="110"
        height="110"
        loading="lazy"
        class="w-24 h-24 lg:w-28 lg:h-28 object-contain filter drop-shadow-md hover:scale-105 transition-transform duration-300 bg-white rounded-full shadow-sm p-0.5"
      />
    </div>
  </div>

  {/* ====================== 6 · CATALOGUES ET ÉVÉNEMENTS (Leclerc Replica Section 5) ====================== */}
  <section class="section bg-white border-b border-neutral-100 py-12">
    <div class="container-mo">
      <div class="mb-8 select-none text-left">
        <h2 class="font-soft font-black text-[22px] md:text-[26px] text-neutral-900 tracking-tight">
          Nos catalogues et événements
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Catalogue 1 -->
        <div class="bg-neutral-50 rounded-2xl p-5 border border-neutral-200/50 flex gap-4">
          <div class="w-24 h-32 bg-rouge/10 rounded-lg shadow border border-neutral-200 flex-shrink-0 overflow-hidden relative group">
            <img src="/promos/promo_rectangulaire.webp" alt="Prospectus" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
            <div class="absolute inset-0 bg-black/10"></div>
          </div>
          <div class="flex flex-col justify-between text-left">
            <div>
              <span class="text-[9.5px] font-black uppercase text-rouge bg-rouge/10 px-2 py-0.5 rounded">Prospectus</span>
              <h3 class="font-bold text-[14.5px] text-neutral-900 mt-2 leading-tight">Le plein de saveurs de l'Aïd</h3>
              <p class="text-[12px] text-neutral-500 mt-1">Du 1er au 14 juin. Promotions majeures sur la boucherie et l'épicerie fine.</p>
            </div>
            <a href="/promos" class="text-[12.5px] font-bold text-vert hover:underline flex items-center gap-1">Consulter le catalogue →</a>
          </div>
        </div>

        <!-- Catalogue 2 -->
        <div class="bg-neutral-50 rounded-2xl p-5 border border-neutral-200/50 flex gap-4">
          <div class="w-24 h-32 bg-vert/10 rounded-lg shadow border border-neutral-200 flex-shrink-0 overflow-hidden relative group">
            <img src="/images/rayons/epices-du-monde.jpg" alt="Catalogue Épices" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
            <div class="absolute inset-0 bg-black/10"></div>
          </div>
          <div class="flex flex-col justify-between text-left">
            <div>
              <span class="text-[9.5px] font-black uppercase text-vert bg-vert/10 px-2 py-0.5 rounded">Arrivage</span>
              <h3 class="font-bold text-[14.5px] text-neutral-900 mt-2 leading-tight">Épices &amp; Douceurs d'Orient</h3>
              <p class="text-[12px] text-neutral-500 mt-1">Nouveautés en direct. Huiles précieuses et spécialités de saison.</p>
            </div>
            <a href="/promos" class="text-[12.5px] font-bold text-vert hover:underline flex items-center gap-1">Consulter les arrivages →</a>
          </div>
        </div>

        <!-- Event Banner Card -->
        <div class="bg-gradient-to-br from-vert to-vert-dark text-white rounded-2xl p-6 flex flex-col justify-between relative overflow-hidden shadow-sm">
          <div class="absolute right-0 bottom-0 opacity-10 pointer-events-none">
            <img src="/logos/favicon-marchedemo-contourwh.png" alt="" class="w-36 h-36" />
          </div>
          <div class="relative z-10 text-left">
            <span class="text-[9px] font-black uppercase bg-white/20 text-white px-2 py-0.5 rounded tracking-wider">Événement</span>
            <h3 class="font-soft font-bold text-[18px] mt-2.5 leading-snug">Grand Marché Frais d'Été</h3>
            <p class="text-[12.5px] text-white/80 mt-1 leading-snug">Profitez d'un arrivage direct de pastèques, melons exotiques et menthe fraîche à prix coûtant.</p>
          </div>
          <a href="/actualites" class="text-[13px] font-bold text-white underline underline-offset-4 hover:opacity-90 mt-5 block text-left">Voir tous les événements</a>
        </div>
      </div>
    </div>
  </section>

  {/* ====================== 7 · SECTIONS CULTURELLES (Maghreb, Asie, Afrique, Inde, Italie) ====================== */}
  {/* SECTION MAGHREB & MÉDITERRANÉE */}
  <section class="section bg-white pt-12 pb-10">
    <div class="container-mo">
      <div class="mb-8 text-left">
        <span class="eyebrow" style={`color: ${CATEGORY_ACCENTS['saveur-mediterranee']}`}>Saveurs de Méditerranée</span>
        <h2 class="display-lg mt-4 text-balance text-neutral-900" data-watermark="Maghreb">
          Le soleil dans votre assiette.
        </h2>
        <p class="mt-4 text-[16px] text-neutral-600 leading-relaxed max-w-2xl">
          Découvrez notre sélection d'huiles d'olive extra vierges tunisiennes, semoule fine pour couscous, olives marinées maison et pâtisseries orientales.
        </p>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 md:gap-5" data-reveal-stagger>
        {maghrebProducts.map((p) => (
          <div class="reveal">
            <ProduitCard produit={p} />
          </div>
        ))}
      </div>
    </div>
  </section>
  <div class="culture-divider" data-culture="maghreb" />

  {/* SECTION ASIE */}
  <section class="section bg-white pt-12 pb-10">
    <div class="container-mo">
      <div class="mb-8 text-left">
        <span class="eyebrow" style={`color: ${CATEGORY_ACCENTS['saveurs-asie']}`}>Saveurs d'Asie</span>
        <h2 class="display-lg mt-4 text-balance text-neutral-900" data-watermark="Asie">
          L'Asie à portée de baguettes.
        </h2>
        <p class="mt-4 text-[16px] text-neutral-600 leading-relaxed max-w-2xl">
          Riz jasmin parfumé, nouilles de blé et de riz, sauces soja de garde, pâtes de curry thaïes et sélection de thés parfumés.
        </p>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 md:gap-5" data-reveal-stagger>
        {asieProducts.map((p) => (
          <div class="reveal">
            <ProduitCard produit={p} />
          </div>
        ))}
      </div>
    </div>
  </section>
  <div class="culture-divider" data-culture="asie" />

  {/* SECTION AFRIQUE & CRÉOLE */}
  <section class="section bg-white pt-12 pb-10">
    <div class="container-mo">
      <div class="mb-8 text-left">
        <span class="eyebrow" style={`color: ${CATEGORY_ACCENTS['saveurs-afrique']}`}>Saveurs d'Afrique &amp; Antilles</span>
        <h2 class="display-lg mt-4 text-balance text-neutral-900" data-watermark="Afrique">
          Saveurs d'Afrique et Créoles.
        </h2>
        <p class="mt-4 text-[16px] text-neutral-600 leading-relaxed max-w-2xl">
          Manioc frais, bananes plantain mûres, farine de fufu, piment végétarien doux, gombos et huiles de palme raffinées de qualité.
        </p>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 md:gap-5" data-reveal-stagger>
        {creoleProducts.map((p) => (
          <div class="reveal">
            <ProduitCard produit={p} />
          </div>
        ))}
      </div>
    </div>
  </section>
  <div class="culture-divider" data-culture="afrique" />

  {/* SECTION INDE */}
  <section class="section bg-white pt-12 pb-10">
    <div class="container-mo">
