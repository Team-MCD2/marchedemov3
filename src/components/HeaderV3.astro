<style>
  /* 1. V3 Burger Animation */
  #burger-btn-v3.is-active .bar-v3:nth-child(1) {
    transform: translateY(5.5px) rotate(45deg);
  }
  #burger-btn-v3.is-active .bar-v3:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }
  #burger-btn-v3.is-active .bar-v3:nth-child(3) {
    transform: translateY(-5.5px) rotate(-45deg);
  }

  /* 2. Hide Horizontal scrollbar */
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

   /* Mobile drawer transition overrides for E.Leclerc drawer */
  @media (max-width: 1023px) {
    #drawer-sidebar-rayons {
      width: 100vw !important;
      max-width: 100% !important;
    }
    
    /* Sticky mobile search overrides when drawer is open */
    #site-header.drawer-open #header-row-mobile-v3 {
      display: none !important;
    }
    #site-header.drawer-open #mobile-search-row-v3 {
      position: fixed !important;
      top: 0 !important;
      left: 0 !important;
      width: 100% !important;
      z-index: 105 !important;
    }
    #site-header.drawer-open #drawer-sidebar-rayons {
      top: 58px !important;
      height: calc(100vh - 58px) !important;
      z-index: 100 !important;
    }
    #site-header.drawer-open #drawer-backdrop {
      top: 58px !important;
      height: calc(100vh - 58px) !important;
      z-index: 95 !important;
    }
    #drawer-search-row-v3 {
      display: none !important;
    }
  }
</style>

<script>
  let searchIndex: any = null;
  let isFetchingIndex = false;
  let fuseProduits: any = null;
  let fuseRayons: any = null;
  let fuseRecettes: any = null;
  let fuseActus: any = null;

  const ensureSearchIndex = async () => {
    if (searchIndex || isFetchingIndex) return;
    isFetchingIndex = true;
    try {
      const res = await fetch("/api/search");
      if (res.ok) {
        searchIndex = await res.json();
        const { default: Fuse } = await import("fuse.js");
        
        fuseProduits = new Fuse(searchIndex.produits, {
          keys: ["title", "rayon", "origine", "badge"],
          threshold: 0.35,
          distance: 100,
        });
        fuseRayons = new Fuse(searchIndex.rayons, {
          keys: ["title", "tagline"],
          threshold: 0.35,
        });
        fuseRecettes = new Fuse(searchIndex.recettes, {
          keys: ["title", "rayon"],
          threshold: 0.35,
        });
        fuseActus = new Fuse(searchIndex.actus, {
          keys: ["title", "categorie"],
          threshold: 0.35,
        });
      }
    } catch (err) {
      console.error("Error loading search index V3:", err);
    } finally {
      isFetchingIndex = false;
    }
  };

  const setupHeaderV3 = () => {
    // Menu Drawer DOM selectors
    const headerEl = document.getElementById("site-header");
    const burgerDesktop = document.getElementById("burger-btn-v3");
    const burgerMobile = document.getElementById("burger-btn-mobile-v3");
    const drawer = document.getElementById("drawer-sidebar-rayons");
    const backdrop = document.getElementById("drawer-backdrop");
    const closeBtn = document.getElementById("drawer-close-btn-v3");

    // Modal DOM selectors
    const storeBtn = document.getElementById("mon-magasin-btn");
    const storeTopMobileBtn = document.getElementById("mobile-magasin-top-btn");
    const storeIconMobileBtn = document.getElementById("mobile-magasins-icon-v3");
    const storeMobileModalTriggers = document.querySelectorAll(".btn-mobile-modal-trigger");
    const modal = document.getElementById("store-detail-modal");
    const modalCloseBg = document.getElementById("store-modal-close-bg");
    const modalCloseBtn = document.getElementById("store-modal-close-btn");
    const modalCloseFooter = document.getElementById("store-modal-close-footer");

    // Search input selectors
    const desktopSearch = document.getElementById("desktop-search-input-v3") as HTMLInputElement | null;
    const desktopSuggestions = document.getElementById("desktop-search-suggestions-v3") as HTMLElement | null;

    const mobileSearch = document.getElementById("mobile-search-input-v3") as HTMLInputElement | null;
    const mobileSuggestions = document.getElementById("mobile-search-suggestions-v3") as HTMLElement | null;

    const drawerSearch = document.getElementById("drawer-search-input-v3") as HTMLInputElement | null;
    const drawerSearchResults = document.getElementById("drawer-search-results-v3") as HTMLElement | null;
    const drawerNavigationMain = document.getElementById("drawer-navigation-main-v3") as HTMLElement | null;

    // A. Drawer Listeners
    const openDrawer = () => {
      drawer?.classList.remove("-translate-x-full");
      backdrop?.classList.remove("opacity-0", "pointer-events-none");
      backdrop?.classList.add("opacity-100", "pointer-events-auto");
      burgerDesktop?.classList.add("is-active");
      headerEl?.classList.add("drawer-open");
      document.body.classList.add("overflow-hidden");
    };

    const closeDrawer = () => {
      drawer?.classList.add("-translate-x-full");
      backdrop?.classList.remove("opacity-100", "pointer-events-auto");
      backdrop?.classList.add("opacity-0", "pointer-events-none");
      burgerDesktop?.classList.remove("is-active");
      headerEl?.classList.remove("drawer-open");
      document.body.classList.remove("overflow-hidden");
    };

    if (burgerDesktop) {
      burgerDesktop.onclick = (e) => {
        e.stopPropagation();
        const isOpen = !drawer?.classList.contains("-translate-x-full");
        if (isOpen) closeDrawer(); else openDrawer();
      };
    }

    if (burgerMobile) {
      burgerMobile.onclick = (e) => {
        e.stopPropagation();
        openDrawer();
      };
    }

    if (closeBtn) closeBtn.onclick = closeDrawer;
    if (backdrop) backdrop.onclick = closeDrawer;

    // B. Modal Listeners
    const openModal = () => {
      modal?.classList.remove("opacity-0", "pointer-events-none");
      modal?.classList.add("opacity-100", "pointer-events-auto");
      const box = modal?.querySelector(".scale-95");
      box?.classList.remove("scale-95");
      box?.classList.add("scale-100");
    };

    const closeModal = () => {
      modal?.classList.remove("opacity-100", "pointer-events-auto");
      modal?.classList.add("opacity-0", "pointer-events-none");
      const box = modal?.querySelector(".scale-100");
      box?.classList.remove("scale-100");
      box?.classList.add("scale-95");
    };

    if (storeBtn) storeBtn.onclick = openModal;
    if (storeTopMobileBtn) storeTopMobileBtn.onclick = openModal;
    if (storeIconMobileBtn) storeIconMobileBtn.onclick = openModal;
    storeMobileModalTriggers.forEach((trigger) => {
      (trigger as HTMLElement).onclick = openModal;
    });

    if (modalCloseBg) modalCloseBg.onclick = closeModal;
    if (modalCloseBtn) modalCloseBtn.onclick = closeModal;
    if (modalCloseFooter) modalCloseFooter.onclick = closeModal;

    // C. Autocomplete suggestions rendering (unified search)
    const performSearchV3General = (query: string, suggestionsContainer: HTMLElement | null, resultsType: "desktop" | "mobile" | "drawer") => {
      const trimmed = query.trim();
      if (trimmed.length === 0) {
        if (resultsType === "drawer") {
          if (drawerNavigationMain) drawerNavigationMain.style.display = "block";
          if (drawerSearchResults) drawerSearchResults.style.display = "none";
        } else {
          suggestionsContainer?.classList.add("opacity-0", "scale-95", "pointer-events-none");
          suggestionsContainer?.classList.remove("opacity-100", "scale-100", "pointer-events-auto", "block");
          if (resultsType === "mobile") suggestionsContainer?.classList.add("hidden");
        }
        return;
      }

      if (resultsType === "drawer") {
        if (drawerNavigationMain) drawerNavigationMain.style.display = "none";
        if (drawerSearchResults) drawerSearchResults.style.display = "block";
      } else {
        suggestionsContainer?.classList.remove("opacity-0", "scale-95", "pointer-events-none", "hidden");
        suggestionsContainer?.classList.add("opacity-100", "scale-100", "pointer-events-auto", "block");
      }

      if (!searchIndex || !fuseProduits) {
        if (suggestionsContainer) {
          suggestionsContainer.innerHTML = `
            <div class="flex items-center justify-center py-8 text-neutral-500 gap-2 font-medium">
              <svg class="animate-spin h-5 w-5 text-vert" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <circle cx="12" cy="12" r="10" stroke-opacity="0.25"/>
                <path d="M12 2v4M12 18v4" stroke-linecap="round"/>
              </svg>
              <span>Recherche...</span>
            </div>
          `;
        }
        ensureSearchIndex().then(() => {
          performSearchV3General(query, suggestionsContainer, resultsType);
        });
        return;
      }

      const products = fuseProduits.search(trimmed).slice(0, 5).map((r: any) => r.item);
      const rayons = fuseRayons.search(trimmed).slice(0, 3).map((r: any) => r.item);
      const recipes = fuseRecettes.search(trimmed).slice(0, 3).map((r: any) => r.item);

      const total = products.length + rayons.length + recipes.length;

      if (total === 0) {
        if (suggestionsContainer) {
          suggestionsContainer.innerHTML = `
            <div class="text-center py-8 text-neutral-500 text-[14px]">
              Aucun résultat pour <strong class="text-neutral-700">"${query}"</strong>.
            </div>
          `;
        }
        return;
      }

      let html = `<div class="space-y-4 text-left">`;

      if (rayons.length > 0) {
        html += `
          <div>
            <div class="text-[11px] font-black text-neutral-400 uppercase tracking-widest mb-1.5 px-2">Rayons</div>
            <div class="space-y-1">
              ${rayons.map((r: any) => `
                <a href="${r.href}" class="flex items-center gap-2.5 p-2 rounded-xl hover:bg-neutral-50 transition-all group">
                  <div class="w-8 h-8 rounded-lg overflow-hidden bg-neutral-100 flex-shrink-0">
                    <img src="${r.image}" alt="" class="w-full h-full object-cover" />
                  </div>
                  <div class="min-w-0 flex-1">
                    <div class="text-[13.5px] font-bold text-neutral-900 group-hover:text-vert transition-colors truncate">${r.title}</div>
                  </div>
                </a>
              `).join("")}
            </div>
          </div>
        `;
      }

      if (products.length > 0) {
        html += `
          <div>
            <div class="text-[11px] font-black text-neutral-400 uppercase tracking-widest mb-1.5 px-2">Produits</div>
            <div class="space-y-1">
              ${products.map((p: any) => `
                <a href="${p.href}" class="flex items-center gap-2.5 p-2 rounded-xl hover:bg-neutral-50 transition-all group">
                  <div class="w-8 h-8 rounded-lg overflow-hidden bg-neutral-100 flex-shrink-0">
                    <img src="${p.image}" alt="" class="w-full h-full object-cover" />
                  </div>
                  <div class="flex-1 min-w-0">
                    <div class="text-[13.5px] font-bold text-neutral-900 group-hover:text-vert transition-colors truncate">${p.title}</div>
                    <div class="text-[11px] text-neutral-500">${p.rayon}</div>
                  </div>
                  ${p.badge ? `<span class="text-[10px] font-bold bg-rouge/10 text-rouge px-2 py-0.5 rounded">${p.badge}</span>` : ""}
                </a>
              `).join("")}
            </div>
          </div>
        `;
      }

      if (recipes.length > 0) {
        html += `
          <div>
            <div class="text-[11px] font-black text-neutral-400 uppercase tracking-widest mb-1.5 px-2">Recettes</div>
            <div class="space-y-1">
              ${recipes.map((r: any) => `
                <a href="${r.href}" class="flex items-center gap-2.5 p-2 rounded-xl hover:bg-neutral-50 transition-all group">
                  <span class="w-6 h-6 rounded-lg bg-vert/10 text-vert flex items-center justify-center text-[12px] font-bold">🍳</span>
                  <div class="flex-1 min-w-0">
                    <div class="text-[13.5px] font-bold text-neutral-900 group-hover:text-vert transition-colors truncate">${r.title}</div>
                  </div>
                </a>
              `).join("")}
            </div>
          </div>
        `;
      }

      html += `</div>`;
      if (suggestionsContainer) suggestionsContainer.innerHTML = html;
    };

    // Binding Desktop Search
    if (desktopSearch) {
      desktopSearch.onfocus = () => {
        ensureSearchIndex();
        if (desktopSearch.value.trim().length > 0) {
          performSearchV3General(desktopSearch.value, desktopSuggestions, "desktop");
        }
      };
      desktopSearch.onmouseenter = ensureSearchIndex;
      desktopSearch.oninput = (e) => {
        const query = (e.target as HTMLInputElement).value;
        performSearchV3General(query, desktopSuggestions, "desktop");
      };
    }

    // Binding Mobile Search
    if (mobileSearch) {
      mobileSearch.onfocus = () => {
        ensureSearchIndex();
        if (mobileSearch.value.trim().length > 0) {
          performSearchV3General(mobileSearch.value, mobileSuggestions, "mobile");
        }
      };
      mobileSearch.onmouseenter = ensureSearchIndex;
      mobileSearch.oninput = (e) => {
        const query = (e.target as HTMLInputElement).value;
        performSearchV3General(query, mobileSuggestions, "mobile");
      };
    }

    // Binding Drawer Search
    if (drawerSearch) {
      drawerSearch.onfocus = ensureSearchIndex;
      drawerSearch.onmouseenter = ensureSearchIndex;
      drawerSearch.oninput = (e) => {
        const query = (e.target as HTMLInputElement).value;
        performSearchV3General(query, drawerSearchResults, "drawer");
      };
    }

    // Click outside search suggestions container
    document.addEventListener("click", (e) => {
      const desktopContainer = document.getElementById("desktop-search-container-v3");
      const mobileContainer = document.getElementById("mobile-search-row-v3");
      const target = e.target as HTMLElement;
      
      if (desktopContainer && !desktopContainer.contains(target)) {
        desktopSuggestions?.classList.add("opacity-0", "scale-95", "pointer-events-none");
        desktopSuggestions?.classList.remove("opacity-100", "scale-100", "pointer-events-auto");
      }
      
      if (mobileContainer && !mobileContainer.contains(target)) {
        mobileSuggestions?.classList.add("opacity-0", "pointer-events-none", "hidden");
        mobileSuggestions?.classList.remove("opacity-100", "pointer-events-auto", "block");
      }
    });
  };

  // Run on mount and page-swaps
  setupHeaderV3();
  document.addEventListener("astro:page-load", setupHeaderV3);
</script>
