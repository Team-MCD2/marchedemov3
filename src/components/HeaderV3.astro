---
/**
 * HeaderV3 — E.Leclerc-style premium storefront header.
 * - Top info bar (mon magasin: Toulouse Sud) - adapts to mobile (without Click&Collect)
 * - Main bar & categories row: hidden on mobile, shown on desktop
 * - Mobile layout: burger (MENU label), centered circular logo, pin/account/cart icons
 * - Sticky mobile search bar at top of viewport on scroll
 * - Sidebar Drawer: full screen on mobile, fixed header with close button, logo, icons, and drawer search bar.
 *   - Scrollable content with Nos Offres (Promotions), Prospectus, Cart, Recettes, Devenir Franchisé, and Rayons.
 */
import { RAYONS_LIST } from "@/lib/site";
import { DEFAULT_STORE } from "@/lib/geo";

const pathname = Astro.url.pathname;
const currentStore = DEFAULT_STORE;

// Accent colors matching V2 rayons for dots/tags
const CATEGORY_ACCENTS: Record<string, string> = {
  "boucherie-halal": "#8B1919",
  "fruits-legumes": "#2E8B4A",
  "epices-du-monde": "#A86B1E",
  "saveurs-afrique": "#C8751A",
  "saveurs-asie": "#1E5F74",
  "saveur-mediterranee": "#0F52BA",
  "saveur-sud-amer": "#B22222",
  "balkans-turques": "#D2691E",
  "produits-courants": "#4A5568",
  "surgeles": "#00A86B",
};
---

<header id="site-header" class="w-full z-50 bg-white lg:sticky lg:top-0 lg:shadow-sm transition-all duration-300 font-pro">
  <!-- ==================== 1. MAIN HEADER ROW ==================== -->
  <!-- Desktop Main White Bar -->
  <div class="w-full bg-white border-b border-neutral-100 py-3.5 shadow-sm hidden lg:block">
    <div class="w-full max-w-[1760px] mx-auto px-4 md:px-6 lg:px-6 flex items-center gap-5 lg:gap-8">
      
      <!-- Burger Rayons -->
      <button 
        id="burger-btn-v3" 
        class="flex items-center gap-2 text-neutral-800 hover:text-vert font-bold font-soft transition-colors select-none"
        aria-label="Ouvrir le menu rayons"
      >
        <div class="burger-icon-v3 flex flex-col justify-between w-5 h-3.5">
          <span class="bar-v3 w-full h-[2.5px] bg-current rounded-full transition-transform"></span>
          <span class="bar-v3 w-full h-[2.5px] bg-current rounded-full transition-all"></span>
          <span class="bar-v3 w-full h-[2.5px] bg-current rounded-full transition-transform"></span>
        </div>
        <span class="text-[14.5px] uppercase tracking-wide hidden sm:inline">Rayons</span>
      </button>

      <!-- Logo Box -->
      <a href="/" class="flex-shrink-0 group">
        <div class="bg-vert hover:bg-vert-dark transition-colors px-4 py-2 rounded-lg flex items-center justify-center shadow-md">
          <img 
            src="/logos/logo-marchedemo-rec-contourwh.png" 
            alt="Marché de Mo'" 
            class="h-9 w-auto object-contain transition-transform group-hover:scale-[1.02]"
            fetchpriority="high"
          />
        </div>
      </a>

      <!-- Central Search Engine -->
      <div id="desktop-search-container-v3" class="flex-1 max-w-[650px] relative mx-auto">
        <div class="relative w-full">
          <input 
            id="desktop-search-input-v3" 
            type="text" 
            placeholder="Rechercher un produit, un rayon, une spécialité..." 
            class="w-full pl-5 pr-12 py-3 bg-neutral-50 text-[14.5px] font-medium text-neutral-900 rounded-full border border-neutral-200 outline-none focus:bg-white focus:border-vert focus:ring-2 focus:ring-vert/15 transition-all placeholder-neutral-400"
            autocomplete="off"
          />
          <button class="absolute right-4 top-1/2 -translate-y-1/2 text-neutral-400 hover:text-vert transition-colors" aria-label="Rechercher">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <circle cx="11" cy="11" r="8" />
              <path d="m21 21-4.35-4.35" />
            </svg>
          </button>
        </div>

        <!-- Desktop Autocomplete Suggestions Overlay -->
        <div 
          id="desktop-search-suggestions-v3" 
          class="absolute top-full left-0 right-0 mt-2 bg-white rounded-2xl shadow-2xl border border-neutral-100 p-4 max-h-[75vh] overflow-y-auto z-50 opacity-0 scale-95 pointer-events-none transition-all duration-200"
        >
          <div class="text-center py-6 text-neutral-500 text-[13.5px]">
            Saisissez un mot pour rechercher...
          </div>
        </div>
      </div>

      <!-- Promo Image + Catalogue + Store -->
      <div class="flex items-center gap-4 lg:gap-5 flex-shrink-0">
        <!-- Promo Image Button (V2-style) -->
        <a
          href="/promos"
          class="inline-flex items-center hover:opacity-90 transition relative z-20 my-[-12px]"
        >
          <img src="/promos/promo_button-removebg-preview.png" alt="Promos" class="h-16 lg:h-20 w-auto object-contain hover:scale-105 transition-transform duration-200" />
        </a>

        <!-- Catalogue Button (Leclerc-style) -->
        <a
          href="/promos"
          class="flex items-center gap-2 px-4 py-2.5 border-2 border-vert text-vert hover:bg-vert hover:text-white rounded-full font-soft font-bold text-[13px] transition-all hover:-translate-y-0.5 select-none"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
            <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
          </svg>
          Catalogues
        </a>

        <!-- Store Pill (Toulouse Sud) -->
        <button
          id="mon-magasin-btn"
          class="flex items-center gap-1.5 px-4 py-2.5 border border-neutral-200 hover:border-vert text-neutral-700 hover:text-vert rounded-full font-soft font-bold text-[13px] transition-all hover:-translate-y-0.5 select-none"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
            <circle cx="12" cy="10" r="3" />
          </svg>
          Toulouse Sud — 7j/7
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Main Header Row (Burger + Centered Logo + Icons) -->
  <div 
    id="header-row-mobile-v3"
    class="lg:hidden w-full h-[72px] border-b border-black/5 bg-white flex items-center justify-between px-3 select-none relative z-20"
  >
    <!-- Left: Burger Menu Button -->
    <button
      id="burger-btn-mobile-v3"
      aria-label="Ouvrir le menu"
      class="flex flex-col items-center justify-center text-[#1052ba] active:scale-95 transition shrink-0 pr-1 select-none"
    >
      <div class="burger-icon relative w-5.5 h-4 flex flex-col justify-between mb-0.5 pointer-events-none">
        <span class="bar w-full h-[2.5px] bg-[#1052ba] rounded-full transition-all duration-300"></span>
        <span class="bar w-full h-[2.5px] bg-[#1052ba] rounded-full transition-all duration-300"></span>
        <span class="bar w-full h-[2.5px] bg-[#1052ba] rounded-full transition-all duration-300"></span>
      </div>
      <span class="text-[9px] font-black uppercase text-[#1052ba] tracking-wider pointer-events-none">Menu</span>
    </button>

    <!-- Mobile Promo Badge -->
    <a href="/promos" class="shrink-0 ml-1">
      <img src="/promos/promo_button-removebg-preview.png" alt="Promos" class="h-10 w-auto object-contain" />
    </a>

    <!-- Center: Centered Circular Logo -->
    <a href="/" class="flex items-center justify-center select-none" title="Retour à l'accueil">
      <img
        src="/logos/logo-marchedemo-rond-contourgreen.png"
        alt="Marché de Mo'"
        width="48"
        height="48"
        class="w-[48px] h-[48px] object-contain bg-white rounded-full shadow-sm p-0.5"
      />
    </a>

    <!-- Right: Leclerc Style Icons Placed on Mobile Right -->
    <div class="flex items-center gap-2.5 shrink-0">
      <!-- Geolocation Pin (Triggers hours modal) -->
      <button
        id="mobile-magasins-icon-v3"
        class="w-9 h-9 rounded-full bg-neutral-50 border border-neutral-200/50 flex items-center justify-center text-[#1052ba] active:bg-neutral-100 transition-colors"
        title="Toulouse Sud"
        aria-label="Toulouse Sud"
      >
        <svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
          <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
          <circle cx="12" cy="10" r="3" />
        </svg>
      </button>

      <!-- Account & Cart removed on mobile -->
    </div>
  </div>

  <!-- Mobile Search Row (Sticky top-0 on mobile scroll) -->
  <div 
    id="mobile-search-row-v3"
    class="lg:hidden sticky top-0 z-40 bg-white border-b border-neutral-200 py-2.5 px-3 shadow-sm select-none transition-all duration-300"
  >
    <div class="relative w-full">
      <input 
        id="mobile-search-input-v3" 
        type="text" 
        placeholder="Que recherchez-vous ?" 
        class="w-full pl-5 pr-12 py-2.5 bg-neutral-50 text-[14px] font-medium text-neutral-900 rounded-full border border-neutral-250 outline-none focus:bg-white focus:border-vert focus:ring-2 focus:ring-vert/15 transition-all placeholder-neutral-400"
        autocomplete="off"
      />
      <button class="absolute right-1 top-1/2 -translate-y-1/2 w-9 h-9 rounded-full bg-[#1052ba] hover:bg-[#0f46a0] text-white flex items-center justify-center transition-colors shadow-sm active:scale-95" aria-label="Rechercher">
        <svg class="w-4.5 h-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <circle cx="11" cy="11" r="8" />
          <path d="m21 21-4.35-4.35" />
        </svg>
      </button>
    </div>
    
    <!-- Mobile Search Suggestions Overlay -->
    <div 
      id="mobile-search-suggestions-v3" 
      class="absolute top-full left-0 right-0 mt-2 mx-3 bg-white rounded-2xl shadow-2xl border border-neutral-200/80 p-4 max-h-[60vh] overflow-y-auto z-50 hidden opacity-0 transition-opacity duration-200"
    >
      <div class="text-center py-6 text-neutral-500 text-[13.5px]">
        Saisissez un mot pour rechercher...
      </div>
    </div>
  </div>

  <!-- ==================== 2. SUB-HEADER / QUICK ACCESS ==================== -->
  <!-- Desktop Sub-Header Category Bar -->
  <div class="w-full bg-neutral-50 border-b border-neutral-200/70 overflow-x-auto scrollbar-hide py-2.5 select-none hidden lg:block">
    <div class="w-full max-w-[1760px] mx-auto px-4 md:px-6 lg:px-6 flex items-center gap-2 md:gap-4 text-[13.5px] font-bold font-soft whitespace-nowrap">
      <a href="/promos" class="text-rouge hover:text-rouge-dark pr-3 border-r border-neutral-300 transition-colors flex items-center gap-1">
        <span class="inline-block w-1.5 h-1.5 rounded-full bg-rouge animate-ping"></span>
        Promotions
      </a>
      {RAYONS_LIST.map((r) => (
        <a 
          href={`/rayons/${r.slug}`} 
          class="text-neutral-700 hover:text-vert px-2 py-0.5 rounded-full hover:bg-neutral-100 transition-all"
        >
          {r.nom}
        </a>
      ))}
    </div>
  </div>

  <!-- Mobile Category Horizontal Scroll bar -->
  <div class="w-full bg-neutral-50 border-b border-neutral-200/70 overflow-x-auto scrollbar-hide py-2 px-3.5 select-none lg:hidden">
    <div class="flex items-center gap-2.5 text-[12.5px] font-bold font-soft whitespace-nowrap">
      <a href="/promos" class="text-rouge hover:text-rouge-dark pr-2 border-r border-neutral-350 transition-colors flex items-center gap-1">
        <span class="inline-block w-1.5 h-1.5 rounded-full bg-rouge animate-ping"></span>
        Promotions
      </a>
      {RAYONS_LIST.map((r) => (
        <a 
          href={`/rayons/${r.slug}`} 
          class="text-neutral-700 hover:text-vert px-2.5 py-0.5 rounded-full hover:bg-neutral-200/50 transition-all"
        >
          {r.nomCourt}
        </a>
      ))}
    </div>
  </div>

  <!-- ==================== 3. MENU DRAWER (Hamburger Menu) ==================== -->
  <!-- Sidebar Rayons Navigation Drawer -->
  <div 
    id="drawer-sidebar-rayons" 
    class="fixed inset-y-0 left-0 w-full lg:w-[380px] bg-white shadow-2xl border-r border-neutral-200/80 z-[100] transform -translate-x-full transition-transform duration-300 ease-in-out flex flex-col font-pro"
  >
    <!-- Drawer Fixed Header (Does not scroll) -->
    <div class="bg-white border-b border-neutral-200 flex flex-col shrink-0 select-none">
      <!-- Row 1: Close button, Centered Logo, Icons -->
      <div class="flex items-center justify-between px-3 h-[60px] border-b border-neutral-100 bg-neutral-50/50">
        <!-- Close button -->
        <button 
          id="drawer-close-btn-v3" 
          class="w-10 h-10 flex items-center justify-center text-neutral-800 hover:text-vert transition-colors text-[20px] font-bold" 
          aria-label="Fermer le menu"
        >
          ✕
        </button>

        <!-- Centered Logo -->
        <a href="/" class="flex items-center justify-center">
          <img
            src="/logos/logo-marchedemo-rond-contourgreen.png"
            alt="Marché de Mo'"
            width="44"
            height="44"
            class="w-[44px] h-[44px] object-contain bg-white rounded-full shadow-sm p-0.5"
          />
        </a>

        <!-- Right icons placeholders for Leclerc layout -->
        <div class="flex items-center gap-2 shrink-0">
          <button
            class="w-8 h-8 rounded-full flex items-center justify-center text-[#1052ba] active:bg-neutral-100 transition-colors btn-mobile-modal-trigger"
            aria-label="Détails magasin"
          >
            <svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
              <circle cx="12" cy="10" r="3" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Row 2: Active Search Bar inside Drawer Menu -->
      <div id="drawer-search-row-v3" class="p-3 bg-white border-b border-neutral-100">
        <div class="relative w-full">
          <input 
            id="drawer-search-input-v3" 
            type="text" 
            placeholder="Que recherchez-vous ?" 
            class="w-full pl-4 pr-10 py-2.5 bg-neutral-50 text-[13.5px] text-neutral-900 rounded-full border border-neutral-200 outline-none focus:bg-white focus:border-vert transition-all placeholder-neutral-400"
            autocomplete="off"
          />
          <button class="absolute right-3 top-1/2 -translate-y-1/2 text-neutral-400 hover:text-vert" aria-label="Rechercher">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <circle cx="11" cy="11" r="8" />
              <path d="m21 21-4.35-4.35" />
            </svg>
          </button>
        </div>
      </div>
    </div>

    <!-- Drawer Scrollable Content -->
    <div class="flex-1 overflow-y-auto p-4 space-y-3 relative bg-white" id="drawer-scrollable-content-v3">
      <!-- Cultural background SVG element -->
      <div class="absolute inset-0 opacity-[0.02] pointer-events-none bg-no-repeat bg-right-top" style="background-image: url('data:image/svg+xml;utf8,<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 160 160\"><path d=\"M160 0 Q100 40 70 110 M160 0 C130 15 105 10 80 5\" stroke=\"%231C6B35\" stroke-width=\"2.5\" fill=\"none\"/></svg>');"></div>
      
      <!-- Drawer Active Search Results Container -->
      <div id="drawer-search-results-v3" class="hidden space-y-3.5">
        <!-- Results injected here -->
      </div>

      <!-- Main Navigation Menu Structure (Hidden when searching) -->
      <div id="drawer-navigation-main-v3" class="space-y-3">
        <!-- 0. Mon Magasin (Toulouse Sud) -->
        <button 
          id="drawer-magasin-btn" 
          class="w-full flex items-center justify-between p-3.5 bg-vert/5 hover:bg-vert/10 text-vert font-black rounded-xl transition-all border border-vert/15 mb-2 btn-mobile-modal-trigger text-[14px]"
          type="button"
        >
          <span class="flex items-center gap-2.5">
            <span class="text-[16px]">📍</span>
            <span>Mon magasin : <strong>Toulouse Sud</strong></span>
          </span>
          <span class="text-[9px] uppercase font-black tracking-wider bg-vert text-white px-2 py-0.5 rounded-full shadow-sm">Horaires</span>
        </button>

        <!-- 1. Promotions (Nos Offres de la semaine) -->
        <a 
          href="/promos" 
          class="flex items-center justify-between p-3.5 bg-rouge/5 hover:bg-rouge/10 text-rouge font-black rounded-xl transition-all border border-rouge/10"
        >
          <span class="flex items-center gap-2">
            <span class="inline-block w-2 h-2 rounded-full bg-rouge animate-ping"></span>
            Promotions de la semaine
          </span>
          <span class="text-[10px] font-black bg-rouge text-white px-2 py-0.5 rounded-full uppercase tracking-wider">Offres</span>
        </a>

        <!-- 2. Catalogues & Prospectus -->
        <a 
          href="/promos" 
          class="flex items-center gap-3.5 p-3 text-neutral-800 hover:bg-neutral-50 rounded-xl transition-all border border-neutral-100 font-bold text-[14px]"
        >
          <span class="w-8 h-8 rounded-lg bg-blue-50 text-[#1052ba] flex items-center justify-center text-[15px]">📖</span>
          <span>Catalogues & Prospectus</span>
        </a>

        <!-- 3. Carte Fidélité -->
        <a 
          href="/programme-fidelite" 
          class="flex items-center gap-3.5 p-3 text-neutral-800 hover:bg-neutral-50 rounded-xl transition-all border border-neutral-100 font-bold text-[14px]"
        >
          <span class="w-8 h-8 rounded-lg bg-amber-50 text-amber-600 flex items-center justify-center text-[15px]">💳</span>
          <span>Carte de Fidélité</span>
        </a>

        <!-- 4. Idées Recettes -->
        <a 
          href="/recettes" 
          class="flex items-center gap-3.5 p-3 text-neutral-800 hover:bg-neutral-50 rounded-xl transition-all border border-neutral-100 font-bold text-[14px]"
        >
          <span class="w-8 h-8 rounded-lg bg-vert/10 text-vert flex items-center justify-center text-[15px]">🍳</span>
          <span>Recettes du Monde</span>
        </a>

        <!-- 5. Devenir Franchisé (Standout V2 style link) -->
        <a 
          href="/franchise" 
          class="flex items-center justify-between p-3.5 bg-vert/5 hover:bg-vert/10 text-vert font-black rounded-xl transition-all border border-vert/15 hover:scale-[1.01]"
        >
          <span class="flex items-center gap-2.5">
            <span class="text-[16px]">🤝</span>
            <span>Devenir Franchisé</span>
          </span>
          <span class="text-[9px] uppercase font-black tracking-wider bg-vert text-white px-2.5 py-0.5 rounded-full shadow-sm">Partenaire</span>
        </a>

        <div class="h-px bg-neutral-200 my-2"></div>

        <!-- 6. Secondary Links -->
        <div class="grid grid-cols-2 gap-2 text-[12.5px] font-bold text-neutral-600">
          <a href="/recrutement" class="p-2.5 hover:bg-neutral-50 hover:text-vert rounded-lg transition-colors border border-neutral-100 text-center">Recrutement</a>
          <a href="/actualites" class="p-2.5 hover:bg-neutral-50 hover:text-vert rounded-lg transition-colors border border-neutral-100 text-center">Actualités</a>
          <a href="/a-propos" class="p-2.5 hover:bg-neutral-50 hover:text-vert rounded-lg transition-colors border border-neutral-100 text-center">Qui sommes-nous ?</a>
          <a href="/service-client" class="p-2.5 hover:bg-neutral-50 hover:text-vert rounded-lg transition-colors border border-neutral-100 text-center">Aide & Contact</a>
        </div>

        <div class="h-px bg-neutral-200 my-2"></div>

        <div class="text-[11.5px] font-black text-neutral-450 uppercase tracking-widest pl-2 mb-2 select-none">
          Commander en ligne
        </div>

        <!-- Rayons list -->
        <div class="space-y-1">
          <a href="/produits" class="flex items-center justify-between p-3 bg-vert/5 hover:bg-vert/10 text-vert font-black rounded-xl transition-all border border-vert/10">
            <span>Tous les produits</span>
            <span>→</span>
          </a>

          {RAYONS_LIST.map((r) => {
            const accent = CATEGORY_ACCENTS[r.slug] || "#1C6B35";
            return (
              <a 
                href={`/rayons/${r.slug}`}
                class="group flex items-center justify-between p-3 rounded-xl hover:bg-neutral-50 transition-all border border-transparent hover:border-neutral-100"
                data-culture={r.slug.replace("saveurs-", "").replace("saveur-", "")}
              >
                <div class="flex items-center gap-3 min-w-0">
                  <span class="w-3 h-3 rounded-full flex-shrink-0" style={`background-color: ${accent}`}></span>
                  <span class="text-[14px] font-bold text-neutral-800 group-hover:text-vert transition-colors truncate">{r.nom}</span>
                </div>
                <svg class="w-4 h-4 text-neutral-400 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <path d="M9 5l7 7-7 7" />
                </svg>
              </a>
            );
          })}
        </div>
      </div>
    </div>
    
    <!-- Drawer Footer -->
    <div class="p-4 border-t border-neutral-100 bg-neutral-50 text-center text-[11px] text-neutral-600 uppercase tracking-widest font-black shrink-0">
      Marché de Mo' · Toulouse Sud
    </div>
  </div>

  <!-- Drawer Backdrop Overlay -->
  <div 
    id="drawer-backdrop" 
    class="fixed inset-0 bg-black/45 z-[90] opacity-0 pointer-events-none transition-opacity duration-300"
  ></div>

  <!-- 5. Interactive Toulouse Sud Store Detail Modal -->
  <div 
    id="store-detail-modal" 
    class="fixed inset-0 z-[110] flex items-center justify-center p-4 opacity-0 pointer-events-none transition-all duration-300 font-pro"
  >
    <!-- Backdrop -->
    <div class="absolute inset-0 bg-black/60 backdrop-blur-sm" id="store-modal-close-bg"></div>
    
    <!-- Modal Box -->
    <div class="bg-white rounded-3xl w-full max-w-[650px] shadow-2xl relative overflow-hidden z-10 flex flex-col border border-neutral-100 transform scale-95 transition-transform duration-300">
      <!-- Title Header -->
      <div class="bg-vert text-white p-6 relative">
        <button id="store-modal-close-btn" class="absolute top-5 right-5 text-white hover:text-neutral-200 transition-colors text-[20px] font-bold" aria-label="Fermer la modal">
          ✕
        </button>
        <span class="text-[10px] font-black text-vert-dark bg-white/10 px-2 py-0.5 rounded-full uppercase tracking-wider">Supermarché Unique</span>
        <h3 class="font-soft font-bold text-[24px] mt-1.5">Marché de Mo' — Toulouse Sud</h3>
        <p class="text-white/80 text-[13px] mt-1">Votre point de vente ethnique exclusif à Toulouse Cépière.</p>
      </div>

      <!-- Detail Body -->
      <div class="p-6 space-y-6 overflow-y-auto max-h-[70vh]">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <!-- Coordinates Block -->
          <div class="space-y-4">
            <div class="flex items-start gap-3">
              <div class="w-9 h-9 rounded-xl bg-vert/10 text-vert flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              </div>
              <div>
                <h4 class="text-[12px] font-bold text-neutral-500 uppercase tracking-wide">Adresse</h4>
                <p class="text-[14.5px] font-bold text-neutral-800 leading-normal mt-0.5">
                  5 rue Joachim du Bellay<br/>
                  31100 Toulouse
                </p>
                <span class="text-[11.5px] text-neutral-600 font-bold block mt-1">(Rocade Sortie 27 · Cépière)</span>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <div class="w-9 h-9 rounded-xl bg-vert/10 text-vert flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              </div>
              <div>
                <h4 class="text-[12px] font-bold text-neutral-500 uppercase tracking-wide">Contact</h4>
                <p class="text-[14.5px] font-bold text-neutral-800 mt-0.5">05 82 95 82 52</p>
                <p class="text-[13px] text-neutral-600 mt-0.5">contact@marchedemo.com</p>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <div class="w-9 h-9 rounded-xl bg-vert/10 text-vert flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="9" y1="9" x2="15" y2="9"/><line x1="9" y1="13" x2="15" y2="13"/><line x1="9" y1="17" x2="15" y2="17"/></svg>
              </div>
              <div>
                <h4 class="text-[12px] font-bold text-neutral-500 uppercase tracking-wide">Infos Services</h4>
                <p class="text-[13px] text-neutral-700 leading-normal mt-1">
                  • 1 200 m² de surface commerciale<br/>
                  • Parking gratuit de 600 places<br/>
                  • Accessibilité PMR totale
                </p>
              </div>
            </div>
          </div>

          <!-- Hours Block -->
          <div class="bg-neutral-50 p-5 rounded-2xl border border-neutral-200/60">
            <h4 class="text-[12px] font-black text-neutral-600 uppercase tracking-widest mb-3 flex items-center gap-1.5">
              <svg class="w-4 h-4 text-vert" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              Horaires d'Ouverture
            </h4>
            <div class="space-y-2 text-[13.5px] font-medium text-neutral-800">
              <div class="flex justify-between pb-1.5 border-b border-neutral-200/50">
                <span>Lundi – Jeudi</span>
                <span class="font-bold">8h30 – 20h30</span>
              </div>
              <div class="flex justify-between pb-1.5 border-b border-neutral-200/50">
                <span>Vendredi</span>
                <span class="font-bold text-vert">8h30 – 13h00<br/>14h00 – 21h00</span>
              </div>
              <div class="flex justify-between pb-1.5 border-b border-neutral-200/50">
                <span>Samedi</span>
                <span class="font-bold">8h30 – 21h00</span>
