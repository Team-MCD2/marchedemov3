---
/**
 * PromoHeroV3 — Leclerc-style hero banner slider.
 * Features: rounded corners, arrows on hover, indicators on bottom, and smooth horizontal sliding.
 */
import type { PromoEntry } from "@/lib/promos-repo";
import { supabaseSrcSet } from "@/lib/image-cdn";

export interface Slide {
  kind: "banner" | "promo" | "editorial" | "video";
  titre: string;
  description: string;
  eyebrow: string;
  image: string;
  imageMobile: string | null;
  imageAlt: string;
  ctaLabel: string;
  ctaHref: string;
  accent: string;
  prixPromo: number | null;
  prixOriginal: number | null;
  reductionPct: number | null;
  videoUrl: string | null;
}

export interface ExtraSlide {
  kind: "editorial";
  eyebrow: string;
  titre: string;
  description: string;
  image: string;
  imageAlt?: string;
  ctaLabel: string;
  ctaHref: string;
  accent?: string;
  videoUrl?: string | null;
}

interface Props {
  promos?: PromoEntry[];
  extraSlides?: ExtraSlide[];
  autoAdvanceMs?: number;
}

const { promos = [], extraSlides = [], autoAdvanceMs = 5000 } = Astro.props as Props;

const agneauBannerSlide = {
  kind: "banner" as const,
  titre: "Promo Agneau Aïd el Kebir",
  description: "",
  eyebrow: "",
  image: "/promos/promo_rectangulaire.webp",
  imageMobile: "/promos/promo_mobile_marchedemo.jpeg" as string | null,
  imageAlt: "Promo agneau Aïd — 290€ prix coûtant, Marché de Mo'",
  ctaLabel: "",
  ctaHref: "/promos",
  accent: "#1C6B35",
  prixPromo: null as number | null,
  prixOriginal: null as number | null,
  reductionPct: null as number | null,
  videoUrl: null as string | null,
};

const promoSlides = promos.slice(0, 5).map((p) => ({
  kind: "promo" as const,
  titre: p.data.titre,
  description: p.data.description || `${p.data.prix_promo}€ au lieu de ${p.data.prix_original}€`,
  eyebrow: "Promotion Exceptionnelle",
  image: p.data.image,
  imageMobile: null as string | null,
  imageAlt: p.data.titre,
  ctaLabel: "Voir la promo",
  ctaHref: "/promos",
  accent: "#8B1919",
  prixPromo: p.data.prix_promo,
  prixOriginal: p.data.prix_original,
  reductionPct: p.data.reduction_pct,
  videoUrl: null as string | null,
}));

const editorialSlides = extraSlides.map((s) => ({
  kind: s.videoUrl ? ("video" as const) : ("editorial" as const),
  titre: s.titre,
  description: s.description,
  eyebrow: s.eyebrow,
  image: s.image,
  imageMobile: null as string | null,
  imageAlt: s.imageAlt ?? s.titre,
  ctaLabel: s.ctaLabel,
  ctaHref: s.ctaHref,
  accent: s.accent ?? "#1C6B35",
  prixPromo: null as number | null,
  prixOriginal: null as number | null,
  reductionPct: null as number | null,
  videoUrl: s.videoUrl || null,
}));

const initialSlides: Slide[] = [agneauBannerSlide, ...promoSlides, ...editorialSlides];

const videoSlide = {
  kind: "video" as const,
  titre: "Votre supermarché du monde à Toulouse",
  description: "Boucherie halal sur carcasse, fruits & légumes exotiques, épices du monde. Ouvert 7j/7.",
  eyebrow: "Présentation",
  image: "/images/home/hero.jpg",
  imageMobile: null as string | null,
  imageAlt: "Vidéo Marché de Mo'",
  ctaLabel: "Découvrir nos rayons",
  ctaHref: "/rayons",
  accent: "#1C6B35",
  prixPromo: null as number | null,
  prixOriginal: null as number | null,
  reductionPct: null as number | null,
  videoUrl: "/videos/marchedemo-promo.mp4",
};

if (!editorialSlides.some((s) => s.kind === "video")) {
  initialSlides.splice(1, 0, videoSlide);
}

const baseSlides = initialSlides;
const slideCount = baseSlides.length;

const heroWidths = [800, 1200, 1600];
const heroSizes = "100vw";
const heroSources = baseSlides.map((s) =>
  s.kind === "banner" || s.image.startsWith("/promos/")
    ? { src: s.image, srcset: "" }
    : supabaseSrcSet(s.image, heroWidths, { quality: 78 }),
);
---

{slideCount > 0 && (
  <div class="w-full py-4 px-4 md:px-6 lg:px-6 select-none">
    <div 
      id="promo-hero-v3" 
      class="relative w-full max-w-[1760px] mx-auto aspect-[21/8] max-h-[420px] min-h-[220px] rounded-2xl overflow-hidden shadow-lg border border-neutral-100 group"
      data-auto-ms={autoAdvanceMs}
      data-slide-count={slideCount}
    >
      <!-- Slides Container -->
      <div 
        id="hero-slides-track" 
        class="w-full h-full flex transition-transform duration-500 ease-out"
        style="transform: translateX(0%);"
      >
        {baseSlides.map((slide, i) => {
          const isVideo = slide.kind === "video";
          const isBanner = slide.kind === "banner";
          
          return (
            <div class="w-full h-full flex-shrink-0 relative">
              {isVideo ? (
                <!-- Split Screen Video Layout — background color synced to
                     the playing video via canvas sampling (cf. PromoHeroV2) -->
                <div data-video-slide class="hero-video-slide w-full h-full flex flex-col-reverse md:flex-row bg-vert relative text-white">
                  <div class="flex-1 p-6 md:p-10 lg:p-14 flex flex-col justify-center z-10">
                    <span class="text-[11px] font-black uppercase tracking-widest bg-white/10 px-3 py-1 rounded-full w-fit mb-3">{slide.eyebrow}</span>
                    <h2 class="font-soft font-bold text-[22px] md:text-[34px] leading-tight text-white mb-2">{slide.titre}</h2>
                    <p class="text-[13.5px] md:text-[15px] text-white/90 leading-relaxed mb-4 max-w-lg">{slide.description}</p>
                    <a href={slide.ctaHref} class="bg-white hover:bg-neutral-100 text-vert font-bold text-[13.5px] px-6 py-2.5 rounded-full shadow-lg w-fit transition-colors">
                      {slide.ctaLabel}
                    </a>
                  </div>
                  <div class="flex-1 flex items-center justify-center p-4 z-10 bg-black/10">
                    <div class="w-full max-w-[380px] aspect-video rounded-xl overflow-hidden shadow-2xl border border-white/10 bg-neutral-900">
                      {slide.videoUrl && (
                        <video muted playsinline loop autoplay class="w-full h-full object-cover">
                          <source src={slide.videoUrl} type="video/mp4" />
                        </video>
                      )}
                    </div>
                  </div>
                </div>
              ) : (
                <!-- Banner Image Layout -->
                <div class="w-full h-full relative">
                  <picture class="w-full h-full block">
                    {slide.imageMobile && (
                      <source media="(max-width: 767px)" srcset={slide.imageMobile} />
                    )}
                    <img
                      src={heroSources[i].src || slide.image}
                      srcset={heroSources[i].srcset || undefined}
                      sizes={heroSizes}
                      alt={slide.imageAlt}
                      loading={i === 0 ? "eager" : "lazy"}
                      class={`w-full h-full ${isBanner ? 'object-contain bg-white p-1' : 'object-cover'}`}
                    />
                  </picture>
                  
                  {!isBanner && (
                    <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/25 to-transparent flex items-end p-6 md:p-10 lg:p-14 text-white">
                      <div class="max-w-xl">
                        <span class="text-[11px] font-black uppercase tracking-widest bg-vert px-3 py-1 rounded-full w-fit mb-2.5 block">{slide.eyebrow}</span>
                        <h2 class="font-soft font-bold text-[22px] md:text-[34px] leading-tight text-white mb-2">{slide.titre}</h2>
                        <p class="text-[13.5px] md:text-[15px] text-white/95 leading-relaxed mb-4">{slide.description}</p>
                        
                        {slide.kind === "promo" && slide.prixPromo != null && (
                          <div class="flex items-baseline gap-3 mb-4 select-none">
                            <span class="text-[32px] font-black leading-none">{slide.prixPromo}€</span>
                            {slide.prixOriginal != null && <span class="text-[16px] text-white/60 line-through">{slide.prixOriginal}€</span>}
                            {slide.reductionPct != null && <span class="text-[12px] bg-white text-rouge font-black px-2 py-0.5 rounded">-{slide.reductionPct}%</span>}
                          </div>
                        )}
                        
                        <a href={slide.ctaHref} class="bg-vert hover:bg-vert-dark text-white font-bold text-[13.5px] px-6 py-2.5 rounded-full shadow-lg w-fit transition-colors inline-block">
                          {slide.ctaLabel}
                        </a>
                      </div>
                    </div>
                  )}
                </div>
              )}
            </div>
          );
        })}
      </div>

      <!-- Navigation Arrows (Shown on Hover) -->
      <button 
        id="hero-prev-btn" 
        class="absolute left-4 top-1/2 -translate-y-1/2 w-11 h-11 rounded-full bg-white/90 hover:bg-white text-neutral-800 flex items-center justify-center shadow-md opacity-0 group-hover:opacity-100 transition-opacity duration-200"
        aria-label="Diapositive précédente"
      >
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m15 18-6-6 6-6"/></svg>
      </button>
      <button 
        id="hero-next-btn" 
        class="absolute right-4 top-1/2 -translate-y-1/2 w-11 h-11 rounded-full bg-white/90 hover:bg-white text-neutral-800 flex items-center justify-center shadow-md opacity-0 group-hover:opacity-100 transition-opacity duration-200"
        aria-label="Diapositive suivante"
      >
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m9 18 6-6-6-6"/></svg>
      </button>

      <!-- Indicator Dots -->
      <div class="absolute bottom-4 left-1/2 -translate-x-1/2 flex gap-2 p-1.5 bg-black/25 backdrop-blur-md rounded-full">
        {baseSlides.map((_, i) => (
          <button
            class="hero-dot w-2 h-2 rounded-full bg-white/45 hover:bg-white transition-all outline-none"
            data-index={i}
            aria-label={`Aller à la diapositive ${i + 1}`}
            aria-current={i === 0 ? "true" : undefined}
          ></button>
        ))}
      </div>
    </div>
  </div>
)}

<style>
  .hero-dot[aria-current="true"] {
    background-color: #1C6B35 !important;
    width: 24px;
    border-radius: 999px;
  }
  /* Video slide : the JS color-sync updates background-color every frame ;
     this transition smooths it into a slow premium drift (cf. V2). */
  .hero-video-slide {
    transition: background-color 1.2s cubic-bezier(0.25, 0.8, 0.25, 1);
  }
</style>

<script>
  const setupPromoHeroV3 = () => {
    const hero = document.getElementById("promo-hero-v3");
    if (!hero) return;

    const track = document.getElementById("hero-slides-track");
    const prevBtn = document.getElementById("hero-prev-btn");
    const nextBtn = document.getElementById("hero-next-btn");
    const dots = Array.from(hero.querySelectorAll<HTMLButtonElement>(".hero-dot"));
    const slideCount = parseInt(hero.dataset.slideCount || "0");
    const autoMs = parseInt(hero.dataset.autoMs || "5000");

    if (!track || slideCount <= 1) return;

    let currentIndex = 0;
    let timer: number | null = null;

    /* ----------------------------------------------------------------
       Video ↔ background color sync (ported from PromoHeroV2).
       Samples the playing video into a 1×1 canvas every frame, converts
       the dominant color to HSL, clamps it to a dark premium tone
       (L 14%, S 25–45%) and paints the slide background. The CSS
       transition on .hero-video-slide smooths the changes.
       ---------------------------------------------------------------- */
    const setupVideoBgSync = (video: HTMLVideoElement, slideElement: HTMLElement) => {
      if ((video as any).__bgSyncSetup) return;
      (video as any).__bgSyncSetup = true;

      const canvas = document.createElement("canvas");
      canvas.width = 1;
      canvas.height = 1;
      const ctx = canvas.getContext("2d", { willReadFrequently: true });
      if (!ctx) return;

      let animFrameId: number;

      const updateColor = () => {
        if (video.paused || video.ended) return;
        try {
          ctx.drawImage(video, 0, 0, 1, 1);
          const pixel = ctx.getImageData(0, 0, 1, 1).data;
          const rNorm = pixel[0] / 255, gNorm = pixel[1] / 255, bNorm = pixel[2] / 255;
          const max = Math.max(rNorm, gNorm, bNorm), min = Math.min(rNorm, gNorm, bNorm);
          let h = 0, s = 0;
          const l = (max + min) / 2;

          if (max !== min) {
            const d = max - min;
            s = l > 0.5 ? d / (2 - max - min) : d / (max + min);
            switch (max) {
              case rNorm: h = (gNorm - bNorm) / d + (gNorm < bNorm ? 6 : 0); break;
              case gNorm: h = (bNorm - rNorm) / d + 2; break;
              case bNorm: h = (rNorm - gNorm) / d + 4; break;
            }
            h /= 6;
          }

          const hue = Math.round(h * 360);
          const targetL = 14; // dark premium background
          const targetS = Math.min(Math.max(Math.round(s * 100), 25), 45);

          slideElement.style.setProperty("background-color", `hsl(${hue}, ${targetS}%, ${targetL}%)`, "important");
        } catch (e) {
          /* canvas read errors (e.g. tainted frame) — skip silently */
        }
        animFrameId = requestAnimationFrame(updateColor);
      };

      video.addEventListener("play", () => updateColor());
      video.addEventListener("pause", () => cancelAnimationFrame(animFrameId));
      if (!video.paused) updateColor();
    };

    /* Play + sync the video of the active slide, pause all others. */
    const slides = Array.from(track.children) as HTMLElement[];
    const syncVideos = () => {
      slides.forEach((slideEl, idx) => {
        const video = slideEl.querySelector<HTMLVideoElement>("video");
        if (!video) return;
        const wrap = slideEl.querySelector<HTMLElement>("[data-video-slide]") ?? slideEl;
        if (idx === currentIndex) {
          setupVideoBgSync(video, wrap);
          video.play().catch(() => {});
        } else {
          video.pause();
        }
      });
    };

    const updateSlider = (index: number) => {
      currentIndex = (index + slideCount) % slideCount;
      track.style.transform = `translateX(-${currentIndex * 100}%)`;

      // Update dots
      dots.forEach((dot, idx) => {
        if (idx === currentIndex) {
          dot.setAttribute("aria-current", "true");
        } else {
          dot.removeAttribute("aria-current");
        }
      });

      syncVideos();
    };

    const nextSlide = () => updateSlider(currentIndex + 1);
    const prevSlide = () => updateSlider(currentIndex - 1);

    const startAutoPlay = () => {
      if (autoMs > 0 && !timer) {
        timer = setInterval(nextSlide, autoMs) as any;
      }
    };

    const stopAutoPlay = () => {
      if (timer) {
        clearInterval(timer);
        timer = null;
      }
    };

    if (prevBtn) prevBtn.onclick = () => { stopAutoPlay(); prevSlide(); startAutoPlay(); };
    if (nextBtn) nextBtn.onclick = () => { stopAutoPlay(); nextSlide(); startAutoPlay(); };

    dots.forEach((dot) => {
      dot.onclick = () => {
        stopAutoPlay();
        const index = parseInt((dot as HTMLElement).dataset.index || "0");
        updateSlider(index);
        startAutoPlay();
      };
    });

    // Pause on hover
    hero.onmouseenter = stopAutoPlay;
    hero.onmouseleave = startAutoPlay;

    // Start
    syncVideos();
    startAutoPlay();
  };

  setupPromoHeroV3();
  document.addEventListener("astro:page-load", setupPromoHeroV3);
</script>
