---
/**
 * ProduitCardV3 — Leclerc-style product display card.
 * - Upper section: rayon label (uppercase) + centered image.
 * - Middle section: product title + origin info.
 * - Bottom section: "Voir le produit" CTA.
 *
 * Doctrine (same as ProduitCardV2) : SANS PRIX. Les produits n'ont pas
 * de champ prix en base et afficher un prix inventé est une pratique
 * commerciale trompeuse. Les prix ne vivent que sur les promos (datées).
 */
import { RAYONS } from "@/lib/site";
import { supabaseSrcSet } from "@/lib/image-cdn";

/* Accepts both ProduitVedette (id, image: string) and ProduitPublic
 * (slug, image: string | null) — the two shapes that feed this card. */
interface ProduitCardData {
  id?: string;
  slug?: string;
  nom: string;
  image: string | null;
  rayon: string;
  badge?: string | null;
  origine?: string | null;
}

interface Props {
  produit: ProduitCardData;
  linkTo?: "produit" | "rayon";
}

const { produit, linkTo = "produit" } = Astro.props as Props;
const rayonData = RAYONS[produit.rayon as keyof typeof RAYONS];
const accent = rayonData?.accent ?? "#1C6B35";
const productId = produit.id || produit.slug || "";
const href = linkTo === "rayon" ? `/rayons/${produit.rayon}` : `/produits/${productId}`;

// Image resolutions
const { src: produitSrc, srcset: produitSrcset } = supabaseSrcSet(
  produit.image ?? "",
  [400, 600],
  { quality: 72 },
);
const produitSizes = "(max-width: 640px) 45vw, (max-width: 1024px) 30vw, 22vw";

const rayonLabel = rayonData?.nomCourt ?? produit.rayon;
---

<div
  class="produit-card group relative flex flex-col justify-between overflow-hidden rounded-2xl bg-white border border-neutral-100 hover:border-vert/20 hover:shadow-lg transition-all duration-300 p-4"
  data-culture={produit.rayon.replace("saveurs-", "").replace("saveur-", "")}
>
  <!-- Card Header Link -->
  <a href={href} class="block flex-1 flex flex-col">
    <!-- Rayon label -->
    <span class="text-[10px] font-black uppercase tracking-widest block mb-2" style={`color: ${accent}`}>
      {rayonLabel}
    </span>

    <!-- Image wrapper -->
    <div class="relative aspect-square w-full overflow-hidden bg-white flex items-center justify-center mb-3">
      {produit.image ? (
        <img
          src={produitSrc}
          srcset={produitSrcset}
          sizes={produitSizes}
          alt={produit.nom}
          loading="lazy"
          decoding="async"
          width="400"
          height="400"
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
        />
      ) : (
        <div class="absolute inset-0 bg-neutral-50 flex flex-col items-center justify-center p-3 text-center rounded-xl border border-dashed border-neutral-200">
          <img
            src="/logos/favicon-marchedemo.png"
            alt=""
            aria-hidden="true"
            width="40"
            height="40"
            class="w-10 h-10 opacity-15 mb-2"
          />
          <p class="font-bold text-[11px] leading-tight text-neutral-500 line-clamp-2">
            {produit.nom}
          </p>
          <span class="text-[9px] text-neutral-500 italic mt-1">Photo à venir</span>
        </div>
      )}

      <!-- Cultural icon/badge stamp -->
      {produit.badge && (
        <span
          class="absolute top-2 left-2 inline-flex items-center px-2 py-0.5 rounded-full bg-white/95 text-[9.5px] font-bold tracking-wide uppercase shadow-sm border border-neutral-100"
          style={`color: ${accent}`}
        >
          {produit.badge}
        </span>
      )}
    </div>

    <!-- Product name -->
    <h3 class="font-bold text-[13.5px] leading-snug text-neutral-800 line-clamp-2 min-h-[2.8em] group-hover:text-vert transition-colors mb-1">
      {produit.nom}
    </h3>

    <!-- Department / Origin -->
    <div class="flex items-center justify-between text-[11px] text-neutral-600 mb-4 font-medium">
      <span class="flex items-center gap-1">
        <span class="w-1.5 h-1.5 rounded-full" style={`background-color: ${accent}`}></span>
        {rayonLabel}
      </span>
      {produit.origine && <span>{produit.origine}</span>}
    </div>
  </a>

  <!-- Card Action Footer (CTA — disponible en magasin) -->
  <div class="flex items-center justify-between border-t border-neutral-100/80 pt-3">
    <span class="text-[10.5px] font-bold uppercase tracking-wide text-vert">
      Disponible en magasin
    </span>
    <a
      href={href}
      class="inline-flex items-center gap-1 text-[12px] font-bold text-neutral-700 group-hover:text-vert transition-colors"
      aria-label={`Voir ${produit.nom}`}
    >
      Voir
      <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M13 5l7 7-7 7" /></svg>
    </a>
  </div>
</div>
